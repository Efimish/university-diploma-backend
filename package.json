{
  "name": "university-diploma-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:docs:md": "drizzle-docs generate --force -d postgresql -f markdown --single-file src/db/schema.ts -o docs/db.md",
    "db:docs:dbml": "drizzle-docs generate --force -d postgresql -f dbml src/db/schema.ts -o docs/db.dbml",
    "db:docs": "pnpm db:docs:md && pnpm db:docs:dbml && prettier --write docs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@elysia/bearer": "^1.4.4",
    "@elysia/cors": "^1.4.3",
    "@elysia/jwt": "^1.4.2",
    "@elysia/openapi": "^1.4.17",
    "@elysiajs/node": "^1.4.5",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.6",
    "drizzle-seed": "^1.0.0-rc.5",
    "elysia": "^1.4.32",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-docs-generator": "^0.8.2",
    "drizzle-kit": "1.0.0-rc.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
